{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "./worker-configuration.d.ts",
      "jest",
      "@cloudflare/workers-types"
    ],
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@shared-types/*": ["./shared-types/*"],
      "@request/*": ["./src/request/*"],
      "@app-state/*": ["./src/app-state/*"],
      "@app-context/*": ["./src/app-context/*"],
      "@app-render-context/*": ["./src/app-render-context/*"],
      "@rendering/*": ["./src/rendering/*"],

      "@utils/*": ["./src/utils/*"],
      "@pages/*": ["./src/pages/*"],
      "@tests/*": ["./tests/*"],
      "@content-cli/*": ["./packages/content-cli/src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "worker-configuration.d.ts",
    "shared-types/",
    "jest.config.ts"
  ]
}
