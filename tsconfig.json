{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
      "./worker-configuration.d.ts",
      "jest",
      "node",
      "@testing-library/jest-dom"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/tests/**/*.ts",
    "setup/**/*.ts",
    "src/app/life-cycle/inspect/inspectts",
    "src/app/life-cycle/request/canonicalisation/config.canonicalisation.request-ingress.ts",
    "src/app/life-cycle/app-render/app-render.js",
    "authored-content/journals/**/*.ts"
  ],
  "exclude": [
    "authored-content/journals/uploaded**/*.ts",
    "src/tools/temp-folder/**/*.ts",
    "audits/**/*/.{cjs}"
  ]
}
