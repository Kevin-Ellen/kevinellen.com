{
  "folders": [
    {
      "name": "kevinellen.com",
      "path": ".",
    },
  ],
  "settings": {
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "*.code-workspace": "package.json,package-lock.json,.nvmrc,tsconfig*.json,.stylelintignore,.npmrc,worker-configuration.d.ts,eslint.config.*,stylelint.config.*,prettierrc.json,.prettierrc*,.prettierignore,.editorconfig,.gitignore,.gitattributes,wrangler.jsonc,.dev.vars,.env,.env.*,jest.config.*,jest.setup.*,*.config.mjs",
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "never",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[scss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "stylelint.validate": ["scss"],
    "scss.lint.boxModel": "ignore",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "eslint.useFlatConfig": true,
    "eslint.validate": ["typescript", "javascript"],
    "jest.runMode": "on-demand",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.wrangler": true,
      "**/node_modules": true,
      "**/.terraform": true,
      "**/*.tfstate": true,
      "**/*.tfstate.backup": true,
      "**/.build": true,
      "**/.ds_store": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.terraform": true,
      "**/.wrangler": true,
      "**/dist": true,
      "**/.ds_store": true,
    },
    "js/ts.tsdk.path": "node_modules/typescript/lib",
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "hashicorp.terraform",
      "orta.vscode-jest",
      "eamodio.gitlens",
      "usernamehw.errorlens",
      "christian-kohler.path-intellisense",
    ],
  },
}
