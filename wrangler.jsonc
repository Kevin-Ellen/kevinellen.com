{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kevinellen",
  "main": "src/app/entry.ts",
  "compatibility_date": "2026-11-09",
  "dev": {
    "port": 8787,
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css?raw"],
      "fallthrough": true,
    },
  ],
  "cache": {
    "enabled": true,
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT_KV",
      "id": "f66a50df4fb14787938bd5e51d74bbeb",
    },
    {
      "binding": "PHOTO_KV",
      "id": "e142fd95a7094802b2d439af8a7f005b",
    },
  ],
}
